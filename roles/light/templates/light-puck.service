[Unit]
Description=Light control

[Install]
WantedBy=multi-user.target

[Service]
Type=simple
WorkingDirectory=/home/pi/light-puck
ExecStart=/home/pi/.local/bin/poetry run python3 -u light.py
Environment=LIGHT_IP_ADDRESS={{ config.light.ip_address }}
Environment=LIGHT_DEVICE_ID={{ config.light.device_id }}
Environment=LIGHT_SOCKET={{ config.light.socket }}
Environment=LIGHT_PUCK_MAC_ADDRESSES={{ config.light.puck_mac_addresses|join(',') }}
Environment=LIGHT_STATSD_HOST={{ config.statsd.host }}
Restart=on-failure
RestartSec=5s
